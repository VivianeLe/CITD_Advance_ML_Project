    "    # Ma trận cho kênh đặc trưng láng giềng; ablation (use_adj=False) -> không có láng giềng.\n",
    "    m.A_nb = A_NB_T if use_adj else torch.zeros(n_nodes, n_nodes, device=DEVICE)\n",
    "    return m.to(DEVICE)\n"
   ]
