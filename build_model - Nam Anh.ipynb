    "# ---------- Ma trận kề ----------\n",
    "def norm_adj(A):\n",
    "    \"\"\"Chuẩn hoá ma trận kề kiểu DCRNN: A_hat = D^{-1/2} (A + I) D^{-1/2}.\"\"\"\n",
    "    At = A + np.eye(len(A)); d = At.sum(1); Dm = 1.0 / np.sqrt(d)\n",
    "    return (Dm[:, None] * At * Dm[None, :]).astype(np.float32)\n",
    "\n",
    "def build_adjacency(dist, train_values, thr=0.1, knn=8):\n",
    "    \"\"\"Xây dựng ma trận kề từ khoảng cách; fallback sang tương quan nếu thiếu dist.\n",
    "\n",
    "    Tham số:\n",
    "        dist        : (N,N) khoảng cách đường đi, có thể có inf cho cặp không nối\n",
    "        train_values: chỉ dùng để tính tương quan dự phòng (không dùng test)\n",
    "        thr         : ngưỡng cắt cạnh theo trọng số Gaussian\n",
    "        knn         : số láng giềng cho fallback tương quan\n",
    "\n",
    "    Trả về:\n",
    "        A     : ma trận kề (N,N) dạng dense, trọng số >= 0, phần lớn bằng 0\n",
    "        A_hat : A đã chuẩn hoá để dùng trong GCN\n",
    "        prox  : ma trận proximity để chọn khu vực gần nhau khi test\n",
    "    \"\"\"\n",
    "    N = train_values.shape[1]\n",
    "    if dist is not None and dist.shape == (N, N):\n",
    "        # Gaussian kernel: cạnh càng gần càng mạnh; cặp xa/không nối bị cắt.\n",
    "        d = dist.astype(\"float64\")\n",
    "        fin = np.isfinite(d) & (d > 0)\n",
    "        # sigma = độ lệch chuẩn của các khoảng cách dương hữu hạn, làm thang cho kernel.\n",
    "        sigma = d[fin].std()\n",
    "        with np.errstate(all=\"ignore\"):\n",
    "            A = np.exp(-(d / sigma) ** 2)\n",
    "        A[~np.isfinite(d)] = 0; A[A < thr] = 0; np.fill_diagonal(A, 0)\n",
    "        # Đối xứng hoá: nếu dữ liệu chỉ có một chiều thì vẫn coi là cạnh hai chiều.\n",
    "        A = np.maximum(A, A.T)\n",
    "        # PROX dùng để chọn \"khu vực\" cảm biến gần nhau khi giả lập hỏng.\n",
    "        prox = np.minimum(d, d.T); prox[~np.isfinite(prox)] = 1e9\n",
    "        src = \"khoảng cách đường đi (Gaussian kernel, DCRNN)\"\n",
    "    else:   # dự phòng: tương quan trên train\n",
    "        # Chỉ dùng train để tránh rò rỉ thông tin từ val/test vào đồ thị.\n",
    "        v = pd.DataFrame(train_values).ffill().bfill().to_numpy()\n",
    "        C = np.nan_to_num(np.corrcoef(v.T)); np.fill_diagonal(C, -1)\n",
    "        A = np.zeros((N, N))\n",
    "        # Lấy top-k cảm biến tương quan cao nhất; tương quan âm bị cắt về 0.\n",
    "        for i in range(N):\n",
    "            nn_ = np.argsort(-C[i])[:knn]; A[i, nn_] = np.maximum(C[i, nn_], 0)\n",
    "        A = np.maximum(A, A.T)\n",
    "        prox = 1 - C; np.fill_diagonal(prox, 0)\n",
    "        src = \"tương quan (dự phòng, không có ma trận khoảng cách)\"\n",
    "    print(f\"adjacency: {src} | cạnh: {(A > 0).sum()} | độ thưa: {(A > 0).mean():.3f}\")\n",
    "    return A, norm_adj(A), prox\n",
    "\n",
    "# A_HAT_T là tensor trên GPU để dùng lại cho mọi model GNN/STGCN.\n",
    "ADJ_RAW, A_HAT, PROX = build_adjacency(DIST, train_data.values, thr=CFG[\"ADJ_THR\"])\n",
    "A_HAT_T = torch.tensor(A_HAT, device=DEVICE)\n"
   ]
  },
