   "outputs": [],
   "source": [
    "# --- Thí nghiệm 2: train lại model tốt nhất với masking augmentation ---\n",
    "# Model \"chuẩn\" đã có trong TRAINED; model \"robust\" học thêm với cảm biến bị giả lập hỏng.\n",
    "std_model = TRAINED[(BEST_MODEL, BEST_SCALER)]\n",
    "rob_model, rob_tr, rob_te = train_model(train_data, val_data, test_data, BEST_SCALER, BEST_MODEL, CFG[\"N_PAST\"],\n",
    "                                        mask_aug=CFG[\"MASK_AUG\"], tag=\"+maskaug\", verbose=False)\n",
    "print(f\"{BEST_MODEL}+maskaug | val MAE {rob_tr['best_val_MAE']:.3f} | val MAPE {rob_tr['best_val_MAPE']:.3f}% \"\n",
    "      f\"| test MAE {rob_te['MAE_avg']:.3f} | test MAPE {rob_te['MAPE_avg']:.3f}%\")\n",
    "\n",
    "# Ba ứng viên đem so sánh trong các kịch bản mất dữ liệu.\n",
    "CANDIDATES = {f\"{BEST_MODEL} (chuẩn)\": std_model, f\"{BEST_MODEL} + maskaug\": rob_model, \"Persistence\": base_model}\n"
   ]
