    "# --- Thí nghiệm 4: hỏng theo khu vực (tâm + k láng giềng gần nhất) ---\n",
    "rng = np.random.default_rng(CFG[\"SEED\"])\n",
    "# 5 tâm cố định theo seed để kịch bản khu vực lặp lại được.\n",
    "CENTERS = rng.choice(N_NODES, size=5, replace=False)\n",
    "\n",
    "def run_region(label, mdl, pct, mnt):\n",
    "    \"\"\"Chạy lần lượt các tâm trong CENTERS, mỗi tâm lấy k cảm biến gần nhất.\n",
    "\n",
    "    pct: % cảm biến mất; mnt: số phút mất. Kết quả là trung bình qua các tâm.\n",
    "    \"\"\"\n",
    "    k = max(1, int(round(pct / 100 * N_NODES))); outs = []\n",
    "    for c in CENTERS:\n",
    "        outs.append(test_model(test_data, mdl.scaler, mdl, miss_pct=pct, miss_minutes=mnt, region=get_region(c, k),\n",
    "                               n_rep=1, log=False))\n",
    "    res = _avg(outs)\n",
    "    ROBUST.append(dict(model=label, scenario=\"region\", miss_pct=pct, miss_minutes=mnt, n_sensors_lost=k, **res))\n",
    "    return res\n",
    "\n",
    "for label, mdl in CANDIDATES.items():\n",
    "    for pct in (10, 20, 30):\n",
    "        for mnt in (15, 30):\n",
    "            run_region(label, mdl, pct, mnt)\n",
    "\n",
    "# So sánh trực tiếp khu vực vs ngẫu nhiên ở cùng tỉ lệ mất.\n",
    "rg = robust_df().query(\"scenario == 'region'\")\n",
    "display(rg.pivot_table(index=[\"miss_pct\", \"miss_minutes\"], columns=\"model\", values=\"MAE_avg\").round(3).rename_axis(columns=\"khu vực - MAE_avg\"))\n",
    "display(rg.pivot_table(index=[\"miss_pct\", \"miss_minutes\"], columns=\"model\", values=\"MAPE_avg\").round(3).rename_axis(columns=\"khu vực - MAPE (%)\"))\n",
    "cmp = pd.concat([rb[rb.miss_pct > 0].assign(kind=\"ngẫu nhiên\"), rg.assign(kind=\"khu vực\")])\n",
    "display(cmp[cmp.miss_minutes == 30].pivot_table(index=\"miss_pct\", columns=[\"kind\", \"model\"], values=\"MAE_avg\").round(3))\n"
