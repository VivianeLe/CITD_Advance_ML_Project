    "# Số kênh input: giá trị + mask (+ 3 kênh thời gian nếu USE_TOD) (+ 1 kênh ma trận kề nếu USE_ADJ_FEAT).\n",
    "#   kênh 0: flow đã scale | kênh 1: mask (1 = cảm biến hoạt động bình thường, 0 = mất dữ liệu)\n",
    "#   kênh 2-4: sin/cos giờ, cờ cuối tuần | kênh cuối: đặc trưng láng giềng từ ma trận kề\n",
    "N_IN = 2 + (3 if CFG[\"USE_TOD\"] else 0) + (1 if CFG[\"USE_ADJ_FEAT\"] else 0)\n",
    "\n",
    "# Ma trận kề thô (trọng số Gaussian, đường chéo = 0) dùng để tính đặc trưng láng giềng.\n",
    "_A_nb = ADJ_RAW.astype(\"float32\").copy(); np.fill_diagonal(_A_nb, 0.0)\n",
    "A_NB_T = torch.tensor(_A_nb, device=DEVICE)\n",
    "\n",
    "def add_adj_feature(xb, A_nb):\n",
    "    \"\"\"Thêm 1 kênh từ ma trận kề: trung bình có trọng số A của các láng giềng ĐANG HOẠT ĐỘNG.\n",
    "\n",
    "    xb: (B,T,N,C) với kênh 0 = giá trị, kênh 1 = mask. Gọi SAU inject_fault để cảm biến hỏng\n",
    "    (mask = 0) không đóng góp vào đặc trưng của láng giềng.\n",
    "    nb[b,t,n] = Σ_m A[n,m]·mask[m]·v[m] / Σ_m A[n,m]·mask[m]; nếu không có láng giềng hoạt động -> dùng v[n].\n",
    "    \"\"\"\n",
    "    if not CFG[\"USE_ADJ_FEAT\"]: return xb\n",
    "    v, m = xb[..., 0].float(), xb[..., 1].float()\n",
    "    num = torch.einsum(\"nm,btm->btn\", A_nb, v * m)\n",
    "    den = torch.einsum(\"nm,btm->btn\", A_nb, m)\n",
    "    nb = torch.where(den > 1e-6, num / den.clamp_min(1e-6), v)\n",
    "    return torch.cat([xb, nb.unsqueeze(-1).to(xb.dtype)], -1)\n",
    "\n",
    "def _zero_(m):\n",
    "    \"\"\"Khởi tạo trọng số/bias bằng 0 để nhánh mới ban đầu không đóng góp.\"\"\"\n",
    "    nn.init.zeros_(m.weight)\n",
    "    if m.bias is not None: nn.init.zeros_(m.bias)\n",
    "    return m\n",
    "\n",
    "class BaseNet(nn.Module):\n",
    "    \"\"\"Lớp cơ sở: core() sinh phần chênh; forward() cộng giá trị cuối cửa sổ nếu RESIDUAL.\"\"\"\n",
    "    def core(self, x): raise NotImplementedError\n",
    "    def forward(self, x):\n",
    "        out = self.core(x)                                  # phần chênh so với persistence\n",
    "        if CFG[\"RESIDUAL\"]: out = out + x[:, -1, :, 0:1]    # neo = giá trị cuối cửa sổ\n",
    "        return out\n",
    "\n",
    "class GRUNet(BaseNet):\n",
    "    \"\"\"GRU dùng chung cho mọi cảm biến; không khai thác quan hệ không gian.\"\"\"\n",
    "    def __init__(self, n_nodes, n_in, n_out, hidden, n_past, A):\n",
    "        super().__init__()\n",
    "        self.gru = nn.GRU(n_in, hidden, num_layers=2, batch_first=True, dropout=0.1)\n",
    "        self.head = _zero_(nn.Linear(hidden, n_out))\n",
    "    def core(self, x):\n",
    "        B, T, N, Fd = x.shape\n",
    "        # Gộp batch và cảm biến để chạy một GRU chung: (B*N, T, C).\n",
    "        h, _ = self.gru(x.permute(0, 2, 1, 3).reshape(B * N, T, Fd))\n",
    "        return self.head(h[:, -1]).reshape(B, N, -1)\n",
    "\n",
    "class GCNNet(BaseNet):\n",
    "    \"\"\"GCN nhẹ: self + láng giềng (A@h) + residual + LayerNorm.\n",
    "\n",
    "    Nhánh láng giềng khởi tạo 0: ban đầu model giống MLP, phần không gian được học dần.\n",
    "    \"\"\"\n",
    "    def __init__(self, n_nodes, n_in, n_out, hidden, n_past, A):\n",
    "        super().__init__()\n",
    "        self.register_buffer(\"A\", A)\n",
    "        self.enc = nn.Linear(n_past * n_in, hidden)\n",
    "        self.slf = nn.ModuleList([nn.Linear(hidden, hidden) for _ in range(2)])\n",
    "        self.nbr = nn.ModuleList([_zero_(nn.Linear(hidden, hidden)) for _ in range(2)])\n",
    "        self.norm = nn.ModuleList([nn.LayerNorm(hidden) for _ in range(2)])\n",
    "        self.head = _zero_(nn.Linear(hidden, n_out)); self.drop = nn.Dropout(0.1)\n",
    "    def core(self, x):\n",
    "        B, T, N, Fd = x.shape\n",
    "        # Mỗi cảm biến là một vector đặc trưng (T*C) -> hidden.\n",
    "        h = F.relu(self.enc(x.permute(0, 2, 1, 3).reshape(B, N, T * Fd)))\n",
    "        for s, g, n in zip(self.slf, self.nbr, self.norm):\n",
    "            # agg[b,n,:] = tổng có trọng số đặc trưng của các cảm biến láng giềng.\n",
    "            agg = torch.einsum(\"nm,bmc->bnc\", self.A, h)\n",
    "            # residual + LayerNorm để ổn định khi xếp 2 lớp.\n",
    "            h = n(h + self.drop(F.relu(s(h) + g(agg))))\n",
    "        return self.head(h)\n",
    "\n",
    "class TemporalGLU(nn.Module):\n",
    "    \"\"\"Conv theo trục thời gian + gated linear unit.\"\"\"\n",
    "    def __init__(self, cin, cout, k=3):\n",
    "        super().__init__(); self.conv = nn.Conv2d(cin, 2 * cout, (k, 1), padding=(k // 2, 0))\n",
    "    def forward(self, x):                                  # x: (B,C,T,N)\n",
    "        p, q = self.conv(x).chunk(2, 1)                    # nửa giá trị, nửa cổng\n",
    "        return p * torch.sigmoid(q)                        # GLU: cổng sigmoid quyết định giữ bao nhiêu thông tin\n",
    "\n",
    "class ChanNorm(nn.Module):\n",
    "    \"\"\"LayerNorm theo kênh, áp dụng độc lập cho từng (thời điểm, cảm biến).\"\"\"\n",
    "    def __init__(self, c): super().__init__(); self.ln = nn.LayerNorm(c)\n",
    "    def forward(self, x):\n",
    "        # LayerNorm cần kênh ở trục cuối: (B,C,T,N) -> (B,T,N,C) -> lại như cũ.\n",
    "        return self.ln(x.permute(0, 2, 3, 1)).permute(0, 3, 1, 2)\n",
    "\n",
    "class STBlock(nn.Module):\n",
    "    \"\"\"Một khối STGCN: temporal GLU -> self + láng giềng -> temporal GLU -> cộng skip -> norm.\"\"\"\n",
    "    def __init__(self, cin, cmid, cout, A):\n",
    "        super().__init__()\n",
    "        self.A = A\n",
    "        self.t1 = TemporalGLU(cin, cmid)\n",
    "        self.slf = nn.Conv2d(cmid, cmid, 1); self.nbr = _zero_(nn.Conv2d(cmid, cmid, 1))\n",
    "        self.t2 = TemporalGLU(cmid, cout); self.norm = ChanNorm(cout)\n",
    "        self.skip = nn.Conv2d(cin, cout, 1) if cin != cout else nn.Identity()\n",
    "    def forward(self, x):\n",
    "        h = self.t1(x)                                     # (B,C,T,N): trộn thời gian\n",
    "        # Tổng hợp láng giềng theo A; nbr khởi tạo 0 nên ban đầu chỉ dùng self.\n",
    "        agg = torch.einsum(\"nm,bctm->bctn\", self.A, h)\n",
    "        h = F.relu(self.slf(h) + self.nbr(agg))            # self + láng giềng\n",
    "        # Nhánh skip giữ thông tin gốc; norm ổn định đầu ra.\n",
    "        return self.norm(self.t2(h) + self.skip(x))\n",
    "\n",
    "class STGCN(BaseNet):\n",
    "    \"\"\"Hai khối STBlock; head dự báo H horizon (15/30/60 phút) cho từng cảm biến.\"\"\"\n",
    "    def __init__(self, n_nodes, n_in, n_out, hidden, n_past, A):\n",
    "        super().__init__()\n",
    "        self.register_buffer(\"A\", A)\n",
    "        self.b1 = STBlock(n_in, hidden, hidden, self.A); self.b2 = STBlock(hidden, hidden, hidden, self.A)\n",
    "        self.head = _zero_(nn.Linear(hidden * n_past, n_out))\n",
    "    def core(self, x):\n",
    "        # Conv2d cần (B,C,T,N); hai khối ST trộn thời gian + không gian.\n",
    "        h = self.b2(self.b1(x.permute(0, 3, 1, 2)))        # (B,C,T,N)\n",
    "        B, C, T, N = h.shape\n",
    "        # Duỗi (C,T) cho từng cảm biến rồi dự báo H horizon.\n",
    "        return self.head(h.permute(0, 3, 1, 2).reshape(B, N, C * T))\n",
    "\n",
