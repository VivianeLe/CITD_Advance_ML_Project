    "## 14. Kịch bản khác 2 — loại bỏ thông tin không gian (ma trận kề)\n",
    "Train lại **GNN** và **STGCN** với `use_adj=False` (ma trận kề → ma trận đơn vị: mỗi cảm biến chỉ nhìn chính nó) và so với bản có ma trận kề. Kỳ vọng: khi cảm biến hỏng, láng giềng giúp \"vá\" thông tin → bỏ không gian làm kết quả xấu đi, nhất là với mất theo khu vực (láng giềng cũng mất nên lợi ích giảm)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {},
     "inputWidgets": {},
     "nuid": "ff73b7ad-83d1-45d1-9618-2d08ed89c4ac",
     "showTitle": true,
     "tableResultSettingsMap": {},
     "title": "Thí nghiệm 5"
    }
   },
   "outputs": [],
   "source": [
    "# --- Thí nghiệm 5: ablation ma trận kề (có adj vs. thay bằng I) ---\n",
    "# +adj: học quan hệ không gian; -adj: A = I, mỗi cảm biến dự báo độc lập.\n",
    "abl = {}\n",
    "for m in (\"GNN\", \"STGCN\"):\n",
    "    # Tái dùng bản +adj từ exp1; train bổ sung nếu exp1 chưa chạy model/scaler này.\n",
    "    key = (m, BEST_SCALER)\n",
    "    if key not in TRAINED:\n",
    "        print(f\"Chưa có {key} trong TRAINED; đang train bản +adj...\")\n",
    "        mdl, _, _ = train_model(train_data, val_data, test_data, BEST_SCALER, m, CFG[\"N_PAST\"],\n",
    "                                use_adj=True, miss_rates=CFG[\"MISS_RATES\"], tag=\"+adj\", verbose=False)\n",
    "        TRAINED[key] = mdl\n",
    "    abl[f\"{m} + adj\"] = TRAINED[key]\n",
    "    # Giữ cùng masking augmentation như exp1, chỉ thay đổi use_adj.\n",
    "    mdl, _, _ = train_model(train_data, val_data, test_data, BEST_SCALER, m, CFG[\"N_PAST\"],\n",
    "                            use_adj=False, miss_rates=CFG[\"MISS_RATES\"], tag=\"-noadj\", verbose=False)\n",
    "    abl[f\"{m} - adj\"] = mdl\n",
    "\n",
    "# Đánh giá 4 kịch bản: sạch, ngẫu nhiên 20/30%, ngẫu nhiên 30/30%, khu vực 20/30%.\n",
    "rows = []\n",
    "for label, mdl in abl.items():\n",
    "    for scen, (pct, mnt) in {\"sạch 0%\": (0, 0), \"ngẫu nhiên 20%/30'\": (20, 30), \"ngẫu nhiên 30%/30'\": (30, 30)}.items():\n",
    "        r = test_model(test_data, mdl.scaler, mdl, miss_pct=pct, miss_minutes=mnt, label=label, scenario=\"ablation_adj\")\n",
    "        rows.append(dict(model=label, scenario=scen, MAE_avg=r[\"MAE_avg\"], MAE_60=r[\"MAE_60\"], MAPE_avg=r[\"MAPE_avg\"]))\n",
    "    r = run_region(label, mdl, 20, 30); rows.append(dict(model=label, scenario=\"khu vực 20%/30'\", MAE_avg=r[\"MAE_avg\"], MAE_60=r[\"MAE_60\"], MAPE_avg=r[\"MAPE_avg\"]))\n",
    "abl_tab = pd.DataFrame(rows).pivot(index=\"model\", columns=\"scenario\", values=\"MAE_avg\").round(3)\n",
    "display(abl_tab)\n",
    "display(pd.DataFrame(rows).pivot(index=\"model\", columns=\"scenario\", values=\"MAPE_avg\").round(3).rename_axis(columns=\"MAPE (%)\"))\n",
    "abl_tab.T.plot.bar(figsize=(11, 4.5), rot=15); plt.ylabel(f\"MAE trung bình ({UNIT})\"); plt.title(\"Ablation: có / không ma trận kề\"); plt.tight_layout(); plt.show()\n"
   ]
  },
