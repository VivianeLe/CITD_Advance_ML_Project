   "source": [
    "# --- Thống kê mô tả trên toàn bộ giá trị quan sát ---\n",
    "# Bỏ NaN để chỉ thống kê trên giá trị quan sát được.\n",
    "obs = VALUES[~np.isnan(VALUES)]\n",
    "desc = pd.Series({\n",
    "    \"count\": obs.size, \"mean\": obs.mean(), \"median\": np.median(obs), \"std\": obs.std(),\n",
    "    \"min\": obs.min(), \"p5\": np.percentile(obs, 5), \"p95\": np.percentile(obs, 95), \"max\": obs.max(),\n",
    "    \"skewness\": float(((obs - obs.mean()) ** 3).mean() / obs.std() ** 3),\n",
    "}, name=\"toàn bộ giá trị quan sát\").to_frame()\n",
