    "def make_synthetic(T=6000, N=60, seed=0):\n",
    "    \"\"\"Sinh dữ liệu giả nhỏ để smoke-test pipeline (không dùng để báo cáo).\"\"\"\n",
    "    # Dữ liệu có chu kỳ ngày, nhiễu trơn, độ lệch riêng theo vị trí cảm biến và lỗ hổng mô phỏng.\n",
    "    rng = np.random.default_rng(seed)\n",
    "    idx = pd.date_range(\"2017-01-01\", periods=T, freq=\"5min\")\n",
    "    xy = rng.uniform(0, 1, (N, 2))\n",
    "    dist = np.linalg.norm(xy[:, None] - xy[None], axis=-1) * 1e4\n",
    "    tod = (idx.hour.values * 60 + idx.minute.values) / 1440.0\n",
    "    # Hai \"đáy\" tốc độ ~ cao điểm sáng (0.35 ngày) và chiều (0.72 ngày).\n",
    "    base = 62 - 25 * np.exp(-((tod - 0.35) / 0.05) ** 2) - 20 * np.exp(-((tod - 0.72) / 0.06) ** 2)\n",
    "    shock = np.cumsum(rng.normal(0, 0.6, (T, 1)), 0) * 0.1\n",
    "    v = base[:, None] + shock + rng.normal(0, 2, (T, N)) + 3 * np.sin(xy[:, 0] * 6)[None]\n",
    "    v = np.clip(v, 3, 75)\n",
    "    v[rng.random((T, N)) < 0.003] = 0          # giá trị 0 giả\n",
    "    v[rng.random((T, N)) < 0.002] = np.nan\n",
    "    v[1000:1100, :5] = np.nan\n",
    "    df = pd.DataFrame(v.astype(\"float32\"), index=idx, columns=[str(400000 + i) for i in range(N)])\n",
    "    return df, dist\n",
    "\n",
    "def _sensor_key(v):\n",
    "    \"\"\"Chuẩn hoá ID cảm biến về string, bỏ đuôi .0 do pandas tạo ra.\"\"\"\n",
    "    s = str(v).strip()\n",
    "    return s[:-2] if s.endswith(\".0\") else s\n",
    "\n",
    "def _distance_from_csv(csv_path, sensor_ids):\n",
    "    \"\"\"Đọc file khoảng cách (from,to,cost) và dựng ma trận khoảng cách (N,N).\n",
    "\n",
    "    PeMS04 (distance.csv): from/to là chỉ số cảm biến 0..N-1 -> khớp với tên cột \"0\"..\"N-1\".\n",
    "\n",
    "    Cặp không có trong file được để inf; build_adjacency sẽ coi là không có cạnh.\n",
    "    \"\"\"\n",
    "    if not Path(csv_path).exists():\n",
    "        return None\n",
    "    try:\n",
    "        d = pd.read_csv(csv_path)\n",
    "    except Exception as e:\n",
    "        print(f\"[!] Không đọc được {csv_path}: {e}\")\n",
    "        return None\n",
    "    cols = {c.lower(): c for c in d.columns}\n",
    "    if not {\"from\", \"to\", \"cost\"} <= set(cols):\n",
    "        print(f\"[!] {csv_path.name} thiếu cột from/to/cost, bỏ qua.\")\n",
    "        return None\n",
    "    index = {_sensor_key(s): i for i, s in enumerate(sensor_ids)}\n",
    "    D = np.full((len(index), len(index)), np.inf, dtype=np.float32)\n",
    "    for a, b, c in zip(d[cols[\"from\"]], d[cols[\"to\"]], d[cols[\"cost\"]]):\n",
    "        ia, ib = index.get(_sensor_key(a)), index.get(_sensor_key(b))\n",
    "        if ia is not None and ib is not None:\n",
    "            D[ia, ib] = np.float32(c)\n",
    "    D = np.minimum(D, D.T)          # graph đối xứng; điền chiều còn thiếu\n",
    "    np.fill_diagonal(D, 0.0)\n",
    "    print(f\"[*] Ma trận khoảng cách: {Path(csv_path).name} | \"\n",
    "          f\"{np.isfinite(D).sum():,} / {D.size:,} cặp có khoảng cách\")\n",
    "    return D\n",
    "\n",
    "def _read_values(main, ds, cfg):\n",
    "    \"\"\"Đọc file dữ liệu chính và trả DataFrame (T, N) của đúng 1 đặc trưng.\n",
    "\n",
    "    PeMS04 (.npz): mảng `data` (T, N, 3) = [flow, occupancy, speed]; lấy kênh FEATURE_IDX.\n",
    "    File npz không có mốc thời gian -> dựng index 5 phút từ ngày bắt đầu của bộ dữ liệu.\n",
    "    PeMS-Bay (.h5): DataFrame (T, N) tốc độ, đã có index thời gian.\n",
    "    \"\"\"\n",
    "    if main.suffix == \".npz\":\n",
    "        z = np.load(main)\n",
    "        arr = z[\"data\"] if \"data\" in z.files else z[z.files[0]]\n",
    "        print(f\"[*] {main.name}: shape {arr.shape} (T, N, F)\")\n",
    "        if arr.ndim == 3:\n",
    "            fi = cfg[\"FEATURE_IDX\"]\n",
    "            print(f\"[*] Lấy đặc trưng kênh {fi} = '{DS['feature']}' làm biến huấn luyện / dự báo\")\n",
    "            arr = arr[..., fi]\n",
    "        idx = pd.date_range(ds[\"start\"], periods=arr.shape[0], freq=f\"{cfg['STEP_MIN']}min\")\n",
    "        return pd.DataFrame(arr.astype(\"float32\"), index=idx, columns=[str(i) for i in range(arr.shape[1])])\n",
    "    return pd.read_hdf(main)\n",
    "\n",
    "def load_data(cfg):\n",
    "    \"\"\"Tải bộ dữ liệu CFG[\"DATASET\"] (mặc định PeMS04 / flow) từ local; nếu không có mới tải zip từ Hugging Face.\n",
    "\n",
    "    Trả về:\n",
    "        df   : DataFrame (T, N), index thời gian 5 phút, 1 đặc trưng (flow với PeMS04)\n",
    "        dist : ma trận khoảng cách (N, N) hoặc None nếu không tìm thấy\n",
    "    \"\"\"\n",
    "    if cfg[\"SYNTHETIC\"]:\n",
    "        print(\"!!! DỮ LIỆU GIẢ - chỉ để test code !!!\")\n",
    "        df, dist = make_synthetic(int(os.environ.get(\"SYN_T\", 6000)), int(os.environ.get(\"SYN_N\", 60)))\n",
    "        return df, dist\n",
    "\n",
    "    ds = DATASETS[cfg[\"DATASET\"]]\n",
    "    main_name = ds[\"main_file\"]\n",
    "    # Ưu tiên dữ liệu local; chỉ tải Hugging Face nếu thật sự chưa có.\n",
    "    # Thử lần lượt các vị trí quen thuộc; dùng vị trí đầu tiên có file chính (pems04.npz).\n",
    "    candidates = [\n",
    "        Path(cfg[\"DATA_DIR\"]),\n",
    "        Path(\"/run/media/hoang/HDD-512GB/data\") / ds[\"dir\"],\n",
    "        Path.cwd() / \"data\" / ds[\"dir\"],\n",
    "    ]\n",
    "    data_dir = next((d for d in candidates if d.exists() and any(d.rglob(main_name))), None)\n",
    "    if data_dir is None:\n",
    "        # Fallback: tải zip đã xử lý từ Hugging Face rồi giải nén vào DATA_DIR.\n",
    "        data_dir = Path(cfg[\"DATA_DIR\"])\n",
    "        data_dir.mkdir(parents=True, exist_ok=True)\n",
    "        from huggingface_hub import hf_hub_download\n",
    "        try:\n",
    "            zp = hf_hub_download(repo_id=cfg[\"HF_REPO\"], filename=cfg[\"HF_FILE\"], repo_type=\"dataset\")\n",
    "        except Exception as e:\n",
    "            raise FileNotFoundError(\n",
    "                f\"Không thấy {main_name} trong {data_dir} và không tải được {cfg['HF_FILE']}. \"\n",
    "                f\"Kiểm tra mạng hoặc copy dữ liệu vào data/{ds['dir']}/.\"\n",
    "            ) from e\n",
    "        with zipfile.ZipFile(zp) as z:\n",
    "            z.extractall(data_dir)\n",
    "    print(f\"[*] Dùng dữ liệu local: {data_dir}\")\n",
    "\n",
    "    # In danh sách file để dễ kiểm tra dữ liệu nào đang được dùng.\n",
    "    files = sorted(f for f in data_dir.rglob(\"*\") if f.is_file())\n",
    "    print(\"files:\", [str(f.relative_to(data_dir)) for f in files])\n",
    "    found = sorted(data_dir.rglob(main_name))\n",
    "    if not found:\n",
    "        raise FileNotFoundError(f\"Không thấy {main_name} trong {data_dir}\")\n",
    "    main = found[0]\n",
    "    df = _read_values(main, ds, cfg)\n",
    "\n",
    "    # Ưu tiên ma trận .npy vuông; nếu không có thì dựng từ file khoảng cách csv.\n",
    "    dist = None\n",
    "    for cand in sorted(data_dir.rglob(\"*.npy\")):\n",
    "        try:\n",
    "            a = np.load(cand)\n",
    "            if a.ndim == 2 and a.shape == (df.shape[1], df.shape[1]):\n",
    "                dist = a.astype(\"float32\")\n",
    "                print(f\"[*] Ma trận khoảng cách từ {cand.name} (npy)\")\n",
    "                break\n",
    "        except Exception:\n",
    "            pass\n",
    "    if dist is None:\n",
    "        csvs = sorted(data_dir.rglob(ds[\"dist_csv\"]))\n",
    "        if csvs:\n",
    "            dist = _distance_from_csv(csvs[0], df.columns)\n",
    "    if dist is None:\n",
    "        print(\"[!] Không có ma trận khoảng cách -> dùng tương quan train (dự phòng).\")\n",
    "    return df, dist\n",
    "\n",
    "# Chạy loader và xem nhanh 3 dòng đầu.\n",
    "raw_df, DIST = load_data(CFG)\n",
    "print(\"shape:\", raw_df.shape)\n",
    "display(raw_df.iloc[:3, :6])\n"
   ]
  },
