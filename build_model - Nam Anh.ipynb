    "# EXPERIMENT_SNAPSHOT_V2\n",
    "# Test sạch cho model tốt nhất trong các lượt đã hoàn tất; các lượt STGCN vẫn tiếp tục.\n",
    "# Chọn checkpoint bằng validation, giữ nguyên kế hoạch train sau khi xem test này.\n",
    "_snapshot_manifests = list((OUTPUT_DIR / \"notebook_v2\").glob(\"search-*/manifest.json\"))\n",
    "if not _snapshot_manifests:\n",
    "    raise FileNotFoundError(\"Chưa có kết quả thử nghiệm V2\")\n",
    "_snapshot_dir = max(_snapshot_manifests, key=lambda p: p.stat().st_mtime).parent\n",
    "_snapshot_manifest = _v2_json.loads((_snapshot_dir / \"manifest.json\").read_text(encoding=\"utf-8\"))\n",
    "_snapshot_rows = _v2_json.loads((_snapshot_dir / \"trials.json\").read_text(encoding=\"utf-8\"))\n",
    "_snapshot_good = sorted((r for r in _snapshot_rows if r[\"status\"] == \"ok\"), key=lambda r: (r[\"val_MAPE\"], r[\"val_MAE\"]))\n",
    "if not _snapshot_good:\n",
    "    raise RuntimeError(\"Chưa có checkpoint hoàn tất\")\n",
    "_snapshot_winner = _snapshot_good[0]\n",
    "_snapshot_path = _snapshot_dir / \"test_snapshot.json\"\n",
    "_snapshot_cached = _v2_json.loads(_snapshot_path.read_text(encoding=\"utf-8\")) if _snapshot_path.exists() else None\n",
    "if _snapshot_cached and _snapshot_cached.get(\"winner_trial_id\") == _snapshot_winner[\"trial_id\"]:\n",
    "    V2_TEST_SNAPSHOT = _snapshot_cached\n",
    "else:\n",
    "    _snapshot_original = CFG.copy()\n",
    "    try:\n",
    "        _snapshot_state = torch.load(_snapshot_dir / _snapshot_winner[\"checkpoint\"], map_location=\"cpu\", weights_only=False)\n",
    "        _snapshot_config = _snapshot_state[\"config\"]\n",
    "        CFG.update(_snapshot_manifest[\"shared\"])\n",
    "        CFG.update(_snapshot_state[\"input_flags\"])\n",
    "        configure_inputs_v2(_snapshot_config[\"use_exog\"])\n",
    "        _snapshot_model = build_model(_snapshot_config[\"model\"], N_NODES, _snapshot_config[\"n_past\"], _snapshot_config[\"hidden\"], use_adj=True)\n",
    "        _snapshot_model.load_state_dict(_snapshot_state[\"state_dict\"])\n",
    "        _snapshot_scaler = SCALERS[_snapshot_config[\"scaler\"]]()\n",
    "        _snapshot_scaler.__dict__.update(_snapshot_state[\"scaler_state\"])\n",
    "        _snapshot_model.scaler, _snapshot_model.fill = _snapshot_scaler, _snapshot_state[\"fill\"]\n",
    "        _snapshot_model.n_past, _snapshot_model.eval_bs = _snapshot_config[\"n_past\"], 32\n",
    "        _snapshot_windows = Windows(test_data, _snapshot_scaler, _snapshot_model.fill, _snapshot_config[\"n_past\"], 1)\n",
    "        _snapshot_metrics = evaluate(_snapshot_model, _snapshot_windows, _snapshot_scaler, bs=32)\n",
    "        V2_TEST_SNAPSHOT = dict(winner_trial_id=_snapshot_winner[\"trial_id\"], config=_snapshot_config,\n",
    "            completed_trials=len(_snapshot_good), planned_trials=len(_snapshot_manifest[\"plan\"]),\n",
    "            validation={k:_snapshot_winner[k] for k in (\"val_MAE\", \"val_MAPE\", \"val_RMSE\")},\n",
    "            train_loss=_snapshot_winner[\"best_train_loss\"], test=_snapshot_metrics,\n",
    "            target_met=dict(loss=_snapshot_winner[\"best_train_loss\"] <= 0.05, test_MAPE=_snapshot_metrics[\"MAPE_avg\"] <= 12.0),\n",
    "            protocol=\"Snapshot chọn bằng validation trong các lượt đã hoàn tất; test sạch. Các lượt còn lại giữ nguyên kế hoạch, không chọn bằng test.\")\n",
    "        _v2_write_json(_snapshot_path, V2_TEST_SNAPSHOT)\n",
    "        del _snapshot_model, _snapshot_windows, _snapshot_state\n",
    "    finally:\n",
    "        CFG.clear(); CFG.update(_snapshot_original)\n",
    "        configure_inputs_v2(_snapshot_original.get(\"USE_EXOG\", False))\n",
    "        _v2_gc.collect(); torch.cuda.empty_cache()\n",
    "print(\"TEST SẠCH — KẾT QUẢ MODEL ĐÃ CHỌN BẰNG VALIDATION:\", flush=True)\n",
    "print(_v2_json.dumps(V2_TEST_SNAPSHOT, ensure_ascii=False, indent=2), flush=True)\n",
    "display(pd.Series(V2_TEST_SNAPSHOT[\"test\"], name=\"test sạch\"))\n"
   ]
