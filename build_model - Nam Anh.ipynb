    "def validate(df):\n",
    "    \"\"\"Kiểm tra tính hợp lệ của DataFrame thô trước khi làm sạch.\n",
    "\n",
    "    Trả về (report dict, num_df) trong đó num_df là bản ép kiểu số để dùng tiếp.\n",
    "    \"\"\"\n",
    "    # Gom các kiểm tra vào một dict để hiển thị thành bảng.\n",
    "    rep = {}\n",
    "    rep[\"shape\"] = df.shape\n",
    "    rep[\"index_is_datetime\"] = isinstance(df.index, pd.DatetimeIndex)\n",
    "    rep[\"index_monotonic_increasing\"] = bool(df.index.is_monotonic_increasing)\n",
    "    rep[\"duplicated_timestamps\"] = int(df.index.duplicated().sum())\n",
    "    rep[\"non_numeric_dtype_columns\"] = [c for c in df.columns if not pd.api.types.is_numeric_dtype(df[c])]\n",
    "    # Ép kiểu số: ô chữ sẽ thành NaN, sau đó đếm riêng để không lẫn với NaN gốc.\n",
    "    num = df.apply(pd.to_numeric, errors=\"coerce\")\n",
    "    rep[\"text_cells_in_numeric_cols\"] = int((num.isna() & df.notna()).sum().sum())\n",
    "    rep[\"nan_cells\"] = int(num.isna().sum().sum())\n",
    "    rep[\"nan_pct\"] = round(100 * rep[\"nan_cells\"] / num.size, 4)\n",
    "    # 0 mph là quy ước \"không đo được\" của PeMS-Bay, sẽ thành NaN ở bước clean.\n",
    "    rep[\"zero_cells\"] = int((num == 0).sum().sum())\n",
    "    rep[\"negative_cells\"] = int((num < 0).sum().sum())\n",
    "    rep[\"inf_cells\"] = int(np.isinf(num.to_numpy(dtype=\"float64\")).sum())\n",
    "    if rep[\"index_is_datetime\"]:\n",
    "        # Kiểm tra lưới thời gian có bị thiếu mốc 5 phút nào không.\n",
    "        full = pd.date_range(df.index.min(), df.index.max(), freq=f\"{CFG['STEP_MIN']}min\")\n",
    "        rep[\"missing_timestamps\"] = int(len(full.difference(df.index)))\n",
    "        rep[\"start\"], rep[\"end\"] = str(df.index.min()), str(df.index.max())\n",
    "    return rep, num\n",
    "\n",
    "# Chạy kiểm tra trước khi làm sạch.\n",
    "report, num_df = validate(raw_df)\n",
    "display(pd.Series(report, name=\"kiểm tra\").to_frame())\n",
    "\n",
    "def clean(num_df, cfg):\n",
    "    \"\"\"Làm sạch dữ liệu: bỏ trùng, điền lưới thời gian, xử lý inf/âm/0.\n",
    "\n",
    "    Quy ước PeMS-Bay: 0 mph và giá trị âm được coi là mất dữ liệu (NaN),\n",
    "    không phải tốc độ thật.\n",
    "    \"\"\"\n",
    "    df = num_df.copy()\n",
    "    # Bỏ mốc trùng, sắp xếp thời gian tăng dần.\n",
    "    df = df[~df.index.duplicated(keep=\"first\")].sort_index()\n",
    "    full = pd.date_range(df.index.min(), df.index.max(), freq=f\"{cfg['STEP_MIN']}min\")\n",
    "    df = df.reindex(full)                       # mốc thiếu -> hàng NaN (giữ lưới thời gian đều)\n",
    "    df = df.replace([np.inf, -np.inf], np.nan)\n",
    "    df[df < 0] = np.nan\n",
    "    if cfg[\"ZERO_AS_MISSING\"]:\n",
    "        df[df == 0] = np.nan\n",
    "    return df.astype(\"float32\")\n",
    "\n",
    "# Làm sạch và lấy mảng (T, N) còn NaN.\n",
    "df = clean(num_df, CFG)\n",
    "VALUES = df.to_numpy()                          # (T, N) có NaN\n",
    "T_ALL, N_NODES = VALUES.shape\n",
    "print(f\"sau làm sạch: T={T_ALL}, N={N_NODES}, NaN={np.isnan(VALUES).mean()*100:.3f}%\")\n"
   ]
  },
