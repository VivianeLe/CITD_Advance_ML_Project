    "# ---------- Imputer (B1) ----------\n",
    "def fit_imputer(train_values):\n",
    "    \"\"\"Tính median theo từng cảm biến trên train; fallback median toàn cục.\"\"\"\n",
    "    med = np.nanmedian(train_values, axis=0)\n",
    "    g = np.nanmedian(train_values)\n",
    "    return np.where(np.isnan(med), g, med).astype(\"float32\")\n",
    "\n",
    "def impute(values, fill):\n",
    "    \"\"\"Điền NaN bằng forward-fill (chỉ nhìn quá khứ) rồi median train.\n",
    "\n",
    "    Forward-fill giữ tính nhân quả: tại thời điểm t không dùng giá trị tương lai.\n",
    "    \"\"\"\n",
    "    arr = pd.DataFrame(values).ffill().to_numpy(copy=True)      # chỉ nhìn về quá khứ\n",
    "    nan = np.isnan(arr)\n",
    "    arr[nan] = np.broadcast_to(fill, arr.shape)[nan]\n",
    "    return arr.astype(\"float32\")\n",
    "\n",
    "# ---------- Scalers (theo từng cảm biến, fit trên train) ----------\n",
    "class BaseScaler:\n",
    "    \"\"\"Giao diện chung: fit trên train, transform/inverse theo từng cảm biến.\"\"\"\n",
    "    name = \"base\"\n",
    "    # _p: đưa tham số numpy sang tensor cùng device/dtype với x.\n",
    "    def _p(self, v, x): return torch.as_tensor(v, device=x.device, dtype=x.dtype)\n",
    "    def fit(self, x): raise NotImplementedError\n",
    "    # fwd/inv áp lên trục cuối (..., N). transform_bnh/inverse_bnh nhận (B,N,H),\n",
    "    # đổi trục để N thành trục cuối, rồi trả lại đúng shape (B,N,H).\n",
    "    def fwd(self, x): raise NotImplementedError\n",
    "    def inv(self, z): raise NotImplementedError\n",
    "    def transform(self, x): return self.fwd(torch.as_tensor(x, dtype=torch.float32))\n",
    "    def transform_bnh(self, y): return self.fwd(y.transpose(1, 2)).transpose(1, 2)      # (B,N,H)\n",
    "    def inverse_bnh(self, z): return self.inv(z.transpose(1, 2)).transpose(1, 2)        # (B,N,H)\n",
    "\n",
    "class StandardScaler(BaseScaler):\n",
    "    \"\"\"Chuẩn hoá theo mean/std của từng cảm biến.\"\"\"\n",
    "    name = \"standard\"\n",
    "    def fit(self, x): self.mu = np.nanmean(x, 0); self.sd = np.nanstd(x, 0) + 1e-6; return self\n",
    "    def fwd(self, x): return (x - self._p(self.mu, x)) / self._p(self.sd, x)\n",
    "    def inv(self, z): return z * self._p(self.sd, z) + self._p(self.mu, z)\n",
    "\n",
    "class MinMaxScaler(BaseScaler):\n",
    "    \"\"\"Chuẩn hoá min-max theo từng cảm biến; tham số fit trên train.\"\"\"\n",
    "    name = \"minmax\"\n",
    "    def fit(self, x): self.mn = np.nanmin(x, 0); self.rg = np.nanmax(x, 0) - self.mn + 1e-6; return self\n",
    "    def fwd(self, x): return (x - self._p(self.mn, x)) / self._p(self.rg, x)\n",
    "    def inv(self, z): return z * self._p(self.rg, z) + self._p(self.mn, z)\n",
    "\n",
    "class LogScaler(BaseScaler):\n",
    "    \"\"\"log1p rồi chuẩn hoá; phù hợp dữ liệu lệch (ví dụ flow đêm thấp / ngày cao).\"\"\"\n",
    "    name = \"log\"\n",
    "    def fit(self, x):\n",
    "        lx = np.log1p(np.clip(x, 0, None)); self.mu = np.nanmean(lx, 0); self.sd = np.nanstd(lx, 0) + 1e-6; return self\n",
    "    def fwd(self, x): return (torch.log1p(x.clamp_min(0)) - self._p(self.mu, x)) / self._p(self.sd, x)\n",
    "    def inv(self, z): return torch.expm1((z * self._p(self.sd, z) + self._p(self.mu, z)).clamp(-10, 12))\n",
    "\n",
    "SCALERS = {\"standard\": StandardScaler, \"minmax\": MinMaxScaler, \"log\": LogScaler}   # thêm scaler khác ở đây\n",
    "\n",
    "# ---------- Đặc trưng thời gian (không phụ thuộc cảm biến, không rò rỉ) ----------\n",
    "def time_features(index):\n",
    "    \"\"\"Tạo sin/cos giờ trong ngày và cờ cuối tuần, shape (T,3).\n",
    "\n",
    "    Sin/cos giúp các giờ kề nhau (23:55 và 00:05) có biểu diễn gần nhau.\n",
    "    \"\"\"\n",
    "    ang = 2 * np.pi * (index.hour.values * 60 + index.minute.values) / 1440.0\n",
    "    wk = (index.dayofweek.values >= 5).astype(\"float32\")                 # thứ 7, CN\n",
    "    return np.stack([np.sin(ang), np.cos(ang), wk], 1).astype(\"float32\")  # (T,3)\n",
    "\n",
    "# ---------- Cửa sổ trượt trong từng tập ----------\n",
    "class Windows:\n",
    "    \"\"\"Quản lý cửa sổ trượt của một tập; input dùng view để tiết kiệm bộ nhớ.\n",
    "\n",
    "    Mỗi mẫu lấy từ get():\n",
    "        x: (C, n_past, N), theo batch là (B, C, n_past, N)\n",
    "        C = 2 (giá trị scale, mask) hoặc 5 (+ sin/cos giờ, cờ cuối tuần)\n",
    "        y: (N, H) tại các mốc trong HORIZONS (mặc định +3, +6, +12 bước)\n",
    "    \"\"\"\n",
    "    def __init__(self, split, scaler, fill, n_past, stride=1):\n",
    "        raw = split.values\n",
    "        observed = ~np.isnan(raw)\n",
    "        z = scaler.transform(impute(raw, fill))\n",
    "        # Kênh 0: giá trị đã scale; kênh 1: mask 1 = quan sát thật, 0 = đã điền.\n",
    "        x = torch.stack([z, torch.as_tensor(observed, dtype=torch.float32)], -1)               # (T,N,2)\n",
    "        if CFG[\"USE_TOD\"]:\n",
    "            # Thêm 3 kênh thời gian, broadcast cho mọi cảm biến.\n",
    "            tf = torch.as_tensor(time_features(split.index))[:, None, :].expand(-1, x.shape[1], -1)\n",
    "            x = torch.cat([x, tf], -1)                                                         # (T,N,5)\n",
    "        x = x.to(DEVICE).contiguous()\n",
    "        self.n_past = n_past\n",
    "        # unfold trượt từng bước và trả view, không copy dữ liệu.\n",
    "        # self.starts bên dưới chọn mẫu dày/thưa theo stride.\n",
    "        self.xw = x.unfold(0, n_past, 1)                                   # (T-n+1, N, C, n_past) view\n",
    "        # Nhãn thô (đơn vị gốc: flow xe/5 phút) + mask; NaN thay bằng 0 nhưng mask = 0 nên không vào loss/metric.\n",
    "        self.y_raw = torch.as_tensor(np.nan_to_num(raw, nan=0.0), dtype=torch.float32, device=DEVICE)\n",
    "        self.y_mask = torch.as_tensor(observed, device=DEVICE)             # chỉ tính metric trên nhãn thật\n",
    "        self.h = torch.tensor(HORIZONS, device=DEVICE)\n",
    "        last = len(raw) - n_past - max(HORIZONS)\n",
    "        assert last >= 0, \"tập quá ngắn\"\n",
    "        self.starts = torch.arange(0, last + 1, stride, device=DEVICE)\n",
    "    def __len__(self): return len(self.starts)\n",
    "    def get(self, pos):\n",
    "        \"\"\"Lấy batch theo vị trí trong self.starts.\"\"\"\n",
    "        s = self.starts[pos]\n",
    "        xb = self.xw[s].permute(0, 3, 1, 2)                                  # (B,C,n,N)\n",
    "        # Thời điểm đích = cuối cửa sổ + horizon (3/6/12 bước).\n",
    "        rows = s[:, None] + self.n_past - 1 + self.h[None, :]                # (B,H)\n",
    "        yr = self.y_raw[rows].permute(0, 2, 1)                               # (B,N,H)\n",
    "        ym = self.y_mask[rows].permute(0, 2, 1)\n",
    "        return xb, yr, ym\n",
    "\n",
    "def batches(n, bs, shuffle):\n",
    "    \"\"\"Sinh chỉ số batch; shuffle dùng random permutation trên GPU.\"\"\"\n",
    "    idx = torch.randperm(n, device=DEVICE) if shuffle else torch.arange(n, device=DEVICE)\n",
    "    for i in range(0, n, bs): yield idx[i:i + bs]\n"
   ]
