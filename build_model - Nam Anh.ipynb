    "        return x[:, -1, :, 0].unsqueeze(-1).repeat(1, 1, self.n_out)\n",
    "\n",
    "MODELS = {\"GRU\": GRUNet, \"GNN\": GCNNet, \"STGCN\": STGCN, \"PERSIST\": PersistenceNet}\n",
