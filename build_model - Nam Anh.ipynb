    "def build_model(name, n_nodes, n_past, hidden, use_adj=True):\n",
    "    \"\"\"Tạo model theo tên; use_adj=False thay A bằng I cho ablation không gian.\"\"\"\n",
    "    A = A_HAT_T if use_adj else torch.eye(n_nodes, device=DEVICE)\n",
