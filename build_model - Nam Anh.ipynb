    "class PersistenceNet(nn.Module):\n",
    "    \"\"\"Baseline: lặp lại giá trị cuối của cửa sổ cho mọi horizon.\"\"\"\n",
    "    def __init__(self, n_nodes, n_in, n_out, hidden, n_past, A):\n",
    "        super().__init__(); self.n_out = n_out\n",
